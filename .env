# URL de conexión a PostgreSQL (driver asyncpg para SQLAlchemy async)
# En Docker usa "db" como host; en local usa "localhost"
DATABASE_URL=postgresql+asyncpg://postgres:biRlZgxoziTfNEXkRGCoPRXHmBlzeQqb@autorack.proxy.rlwy.net:20154/railway

# Clave privada RS256 en una sola línea (reemplazar saltos de línea con \n)
# Generar: openssl genrsa -out private.pem 2048
SECRET_KEY=dev

# Clave pública RS256 en una sola línea (reemplazar saltos de línea con \n)
# Generar: openssl rsa -in private.pem -pubout -out public.pem
PUBLIC_KEY=dev

# Algoritmo de firma JWT (no cambiar)
ALGORITHM=RS256

# Tiempo de expiración del access token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tiempo de expiración del refresh token en días
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Orígenes permitidos para CORS (JSON array como string)
# Ejemplo con múltiples orígenes: ["http://localhost:3000","https://app.ejemplo.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3008","http://localhost:8003","http://10.0.2.2:3000","http://10.0.2.2:3008","http://10.0.2.2:8003","https://sum4-tall-frontend.onrender.com"]
